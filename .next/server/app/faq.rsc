5:["$","div",null,{"className":"page-container","children":[["$","h1",null,{"className":"page-title","children":"Q & A's"}],["$","p",null,{"className":"intro-text","children":"Find answers to common questions about our hair and makeup services, booking process, and policies."}],["$","section",null,{"className":"section-card","children":[["$","div","0",{"className":"faq-item","children":[["$","h3",null,{"className":"feature-title-with-logo","children":[["$","img",null,{"src":"/_next/static/media/wcf-lips-logo.443457bf.png","alt":"Lips logo","className":"lips-logo-bullet"}],"What are your business hours to get a hold of you?"]}],["$","p",null,{"className":"faq-answer","dangerouslySetInnerHTML":{"__html":"Our client communication and administrative hours for hair and makeup inquiries are Monday–Friday, 10am–6pm. During this time, we respond to emails and phone calls regarding bookings and services.\n\nWe are unable to respond to emails on weekends as we are focused on providing an excellent experience for our on-location hair and makeup clients who are booked for weddings and events during that time."}}]]}],["$","div","1",{"className":"faq-item","children":[["$","h3",null,{"className":"feature-title-with-logo","children":[["$","img",null,{"src":"/_next/static/media/wcf-lips-logo.443457bf.png","alt":"Lips logo","className":"lips-logo-bullet"}],"How can I contact you to book hair and makeup services?"]}],["$","p",null,{"className":"faq-answer","dangerouslySetInnerHTML":{"__html":"For the fastest and most organized response, please use email or our contact form when inquiring about hair and makeup services. This allows us to keep all your event details in one place and ensure a seamless booking experience.\n\nWe are also available by phone during business hours (Monday–Friday, 10am–6pm). Please refrain from texting and instead call and leave a voicemail if we are unavailable, so we can get back to you shortly!"}}]]}],["$","div","2",{"className":"faq-item","children":[["$","h3",null,{"className":"feature-title-with-logo","children":[["$","img",null,{"src":"/_next/static/media/wcf-lips-logo.443457bf.png","alt":"Lips logo","className":"lips-logo-bullet"}],"How is my contract sent?"]}],["$","p",null,{"className":"faq-answer","dangerouslySetInnerHTML":{"__html":"We send all of our contracts via email in a shared Word document. We're happy to clarify anything on the contract before it gets completed."}}]]}],["$","div","3",{"className":"faq-item","children":[["$","h3",null,{"className":"feature-title-with-logo","children":[["$","img",null,{"src":"/_next/static/media/wcf-lips-logo.443457bf.png","alt":"Lips logo","className":"lips-logo-bullet"}],"How do I pay my retainer or booking fee for hair and makeup services?"]}],["$","p",null,{"className":"faq-answer","dangerouslySetInnerHTML":{"__html":"All booking fees and retainers are paid securely via Venmo. A direct payment link is available at the bottom of this page and on our Contact page for your convenience. Your date is officially secured once your retainer has been received."}}]]}],["$","div","4",{"className":"faq-item","children":[["$","h3",null,{"className":"feature-title-with-logo","children":[["$","img",null,{"src":"/_next/static/media/wcf-lips-logo.443457bf.png","alt":"Lips logo","className":"lips-logo-bullet"}],"Where is my hair / makeup appointment located?"]}],["$","p",null,{"className":"faq-answer","dangerouslySetInnerHTML":{"__html":"Unless otherwise arranged at booking, your hair and makeup appointment will take place at the artist’s studio location, which varies by city: Pittsburgh, Atlanta, or New Orleans. Your full location details will be provided in your confirmation email within 72 hours of your scheduled service."}}]]}],["$","div","5",{"className":"faq-item","children":[["$","h3",null,{"className":"feature-title-with-logo","children":["$L10","How should I prep for my hair/makeup appointment?"]}],"$L11"]}],"$L12","$L13","$L14","$L15","$L16","$L17"]}]]}]
9:{"metadata":[["$","title","0",{"children":"Hair & Makeup Artist FAQ | Pittsburgh, Atlanta & New Orleans | Wild Child Fabrications"}],["$","meta","1",{"name":"description","content":"Find answers about booking hair and makeup services, including business hours, payments, appointments, bridal pricing, preparation, studio policies, and inclusivity. Serving clients across Pittsburgh, Atlanta, and New Orleans."}],["$","link","2",{"rel":"canonical","href":"https://wildchild-makeup.com/faq"}],["$","meta","3",{"property":"og:title","content":"Hair & Makeup Artist FAQ | Pittsburgh, Atlanta & New Orleans | Wild Child Fabrications"}],["$","meta","4",{"property":"og:description","content":"Find answers about booking hair and makeup services, including business hours, payments, appointments, bridal pricing, preparation, studio policies, and inclusivity. Serving clients across Pittsburgh, Atlanta, and New Orleans."}],["$","meta","5",{"property":"og:url","content":"https://wildchild-makeup.com/faq"}],["$","meta","6",{"name":"twitter:card","content":"summary"}],["$","meta","7",{"name":"twitter:title","content":"Hair & Makeup Artist FAQ | Pittsburgh, Atlanta & New Orleans | Wild Child Fabrications"}],["$","meta","8",{"name":"twitter:description","content":"Find answers about booking hair and makeup services, including business hours, payments, appointments, bridal pricing, preparation, studio policies, and inclusivity. Serving clients across Pittsburgh, Atlanta, and New Orleans."}]],"error":null,"digest":"$undefined"}
