5:["$","div",null,{"className":"page-container","children":[["$","h1",null,{"className":"page-title","children":"Film, TV & Commercial Hair & Makeup Artist | Pittsburgh, Atlanta & New Orleans | Wild Child Fabrications"}],["$","p",null,{"className":"intro-text","children":"We provide professional hair and makeup services for television production, film, print advertising, commercial campaigns, and special events. Based in Pittsburgh with teams in Atlanta and New Orleans, our work is designed for high-definition, on-set, and editorial environments."}],["$","section",null,{"className":"section-card","children":[["$","h2",null,{"className":"section-title section-title-media","children":"Our Collaborative On-Set Beauty Process"}],["$","p",null,{"className":"body-text","children":"We take time to understand your vision, goals, and creative direction for television, film, print, and commercial productions. From there, we design on-set hair and makeup that performs beautifully on camera, specializing in natural, everyday beauty for film and television, as well as polished looks for commercial and print work—built to hold up under production lighting and demanding shoot environments."}]]}],["$","section",null,{"className":"section-card","children":[["$","h2",null,{"className":"section-title section-title-media","children":"Why We’re a Strong Choice for Production Hair & Makeup"}],["$","div",null,{"className":"grid-auto","children":[["$","div","0",{"className":"content-card","children":[["$","h3",null,{"className":"accent-text","children":"Camera-Ready Hair & Makeup Results"}],["$","p",null,{"className":"body-text","children":"We create camera-ready hair and makeup using the right professional products and techniques for each skin tone, ensuring every look translates seamlessly on film, television, print, and commercial sets under a variety of lighting conditions."}]]}],["$","div","1",{"className":"content-card","children":[["$","h3",null,{"className":"accent-text","children":"Durability + Production Expertise"}],["$","p",null,{"className":"body-text","children":"With 13 years of experience, our long-wear expertise delivers flawless hair and makeup through long shoot days, changing lighting, and varying production environments—built for film, television, print, and commercial work with lasting continuity and on-set performance"}]]}],["$","div","2",{"className":"content-card","children":[["$","h3",null,{"className":"accent-text","children":"Multi-City Production Availability"}],["$","p",null,{"className":"body-text","children":"We provide on-location hair and makeup services for television, film, print, and commercial productions in Pittsburgh, Atlanta, and New Orleans. Our multi-city team ensures reliable, camera-ready beauty support for productions of all sizes."}]]}]]}]]}],["$","section",null,{"className":"section-card","children":[["$","h2",null,{"className":"section-title section-title-media","children":"Rates"}],["$","p",null,{"className":"muted-text","children":"All rates include kit rental. Travel fees may apply."}],["$","div",null,{"className":"grid-rates","children":[["$","div","0",{"className":"content-card","children":[["$","h3",null,{"children":"Full day"}],["$","p",null,{"className":"muted-text","children":"up to 10 hrs"}],["$","p",null,{"className":"price-text","children":"Starting at $750"}]]}],["$","div","1",{"className":"content-card","children":[["$","h3",null,{"children":"Half day"}],["$","p",null,{"className":"muted-text","children":"up to 5 hrs"}],["$","p",null,{"className":"price-text","children":"Starting at $475"}]]}],["$","div","2",{"className":"content-card","children":[["$","h3",null,{"children":"Travel"}],["$","p",null,{"className":"muted-text","children":"Over 40 miles from artists location will require additional mileage + hourly rate."}],["$","p",null,{"className":"price-text","children":"varies"}]]}]]}]]}],["$","section",null,{"className":"section-card","children":["$L10","$L11"]}],"$L12"]}]
